---
const { name, score } = Astro.props;

const skills_animationTimeSeconds = 2.0;
---

<div class="skill trigger-in-view">
    <p>{name}</p><p>{score}</p>
</div>      

<style define:vars={{ score:`${score}%`, animationDuration:`${skills_animationTimeSeconds * (score/100)}s` }}>
@keyframes skill_expand {
  from {
    width: 0%;
  }
}

.skill {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 0px 20px;
  font-size: 1.5em;
  margin-bottom: 10px;
  background: linear-gradient(
    90deg,
    rgba(130, 0, 185, 1) 0%,
    rgba(25, 62, 171, 1) 51%,
    rgba(0, 185, 6, 1) 100%
  );
  overflow: hidden;
  width: var(--score);
  animation-duration: var(--animationDuration);
}

.skill.in-view {
  animation-name: skill_expand;
}

.skill > p {
  margin: 10px 0px;
  white-space: nowrap;
}
</style>